# Django Configurations (Set DEBUG=False in Production)
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False
# Temporary override: allows all hosts/CORS origins and identity API CSRF origins.
# Also uses Secure SameSite=None cookies; set False to restore explicit lists below.
ALLOW_ALL_HOSTS_AND_ORIGINS=False
ALLOWED_HOSTS=13.49.183.176,127.0.0.1,localhost,yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://your-frontend-domain.com
CSRF_TRUSTED_ORIGINS=https://app.your-domain.com
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SAMESITE=Lax
SECURE_SSL_REDIRECT=True
# Only enable when your HTTPS reverse proxy overwrites X-Forwarded-Proto.
TRUST_PROXY_SSL_HEADER=True
IDENTITY_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Database Connection (Supabase PostgreSQL Connection URI)
# Direct connection (Port 5432) or PgBouncer pooler (Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Paystack API Keys (Payment gateway)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid API Keys (Email OTP delivery)
SENDGRID_API_KEY=your_sendgrid_key_here

# Brevo API Keys (Alternative Email OTP delivery - Free 300 emails/day)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_verified_brevo_email@domain.com

# Cloudinary URL (KYC/evidence file uploads fallback; local storage used if blank)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# Termii: real transactional SMS only. Copy the exact base URL from your dashboard.
TERMII_API_KEY=
TERMII_BASE_URL=
TERMII_SENDER_ID=
# Optional handset delivery reports. OTP send/verify and SMS work without them.
TERMII_WEBHOOKS_ENABLED=False
# Only configure these after confirming Termii's webhook signing mechanism.
# This is our application variable, not a separate credential guaranteed by Termii.
# TERMII_WEBHOOK_SECRET=
# TERMII_WEBHOOK_SIGNATURE_ENCODING=hex
TERMII_CONNECT_TIMEOUT_SECONDS=3
TERMII_READ_TIMEOUT_SECONDS=10
PUBLIC_API_BASE_URL=https://api.your-domain.com
SMS_ENABLED=True
SMS_DAILY_SEND_LIMIT=500
OTP_SENDS_PER_HOUR=5
OTP_SENDS_PER_DAY=10
OTP_IP_SENDS_PER_HOUR=20
OTP_VERIFY_ATTEMPTS_PER_HOUR=20
OTP_VERIFY_IP_ATTEMPTS_PER_HOUR=100
