# Django Configurations (Set DEBUG=False in Production)
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=False
ALLOWED_HOSTS=13.49.183.176,127.0.0.1,localhost,yourdomain.com
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://your-frontend-domain.com

# Database Connection (Supabase PostgreSQL Connection URI)
# Direct connection (Port 5432) or PgBouncer pooler (Port 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Paystack API Keys (Payment gateway)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid API Keys (Email OTP delivery)
SENDGRID_API_KEY=your_sendgrid_key_here

# Brevo API Keys (Alternative Email OTP delivery - Free 300 emails/day)
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BREVO_SENDER_EMAIL=your_verified_brevo_email@domain.com

# Cloudinary URL (KYC/evidence file uploads fallback; local storage used if blank)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

