# Django Configurations
DJANGO_SECRET_KEY=your_django_secret_key_here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOW_ALL_ORIGINS=True
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database Connection (sqlite is used by default if blank or commented)
# DATABASE_URL=postgresql://user:password@localhost:5432/vurex_db

# Paystack API Keys (Payment gateway)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SendGrid API Keys (Email OTP delivery)
SENDGRID_API_KEY=your_sendgrid_key_here

# Brevo API Keys (Alternative Email OTP delivery - Free 300 emails/day)
BREVO_API_KEY=your_brevo_api_key_here

# Cloudinary URL (KYC/evidence file uploads fallback; local storage used if blank)
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
